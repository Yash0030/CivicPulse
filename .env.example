# ==============================================================================
# CivicPulse Unified Environment Template
# ==============================================================================
# Copy this to backend/.env and frontend/.env or run with Docker Compose.

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Configuration (Local or MongoDB Atlas)
# Note: CivicPulse includes an in-memory resilient fallback if MongoDB is not running!
MONGODB_URI=mongodb://localhost:27017/civic_pulse_db
DB_NAME=civic_pulse_db

# JWT Security
JWT_SECRET=super_secret_civic_pulse_token_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Multimodal AI (Google Gemini 2.0 Flash)
# Note: Deterministic vision fallback engages automatically if no key is provided
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Autonomous Email Dispatcher (LangGraph SMTP Node)
# Leave empty or set to mock to simulate without real SMTP credentials
SENDER_EMAIL=civic.agent.system@gmail.com
APP_PASSWORD=your_gmail_app_password
DEFAULT_AUTHORITY_EMAIL=municipal.grievance.cell@gmail.com

# Cloudinary (Optional - for persistent cloud image hosting; falls back to Base64)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Roboflow Computer Vision (Optional - for road damage segmentation)
ROBOFLOW_API_KEY=your_roboflow_api_key
ROBOFLOW_WORKSPACE=aegis
ROBOFLOW_PROJECT=pothole-detection-i00zy
ROBOFLOW_VERSION=2

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite + React 19)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_TITLE="CivicPulse - AI Civic Grievance & Infrastructure Triage"
