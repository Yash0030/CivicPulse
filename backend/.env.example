# CivicPulse Backend Environment Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Configuration (Local or Atlas)
MONGODB_URI=mongodb://localhost:27017/civic_pulse_db
DB_NAME=civic_pulse_db

# JWT Security
JWT_SECRET=super_secret_civic_pulse_token_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LangGraph Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Email Dispatcher & Authority Routing (Optional - mocks if empty)
SENDER_EMAIL=civic.agent.system@gmail.com
APP_PASSWORD=your_gmail_app_password
DEFAULT_AUTHORITY_EMAIL=municipal.grievance.cell@gmail.com

# Cloudinary Configuration (Cloud Image Hosting)
CLOUDINARY_CLOUD_NAME=dw1eccnl7
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Roboflow Configuration (Specialized Pothole Computer Vision)
ROBOFLOW_API_KEY=your_roboflow_api_key
ROBOFLOW_PROJECT=pothole-detection-i00zy
ROBOFLOW_VERSION=2
